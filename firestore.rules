rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function roomRef(roomId) {
      return /databases/$(database)/documents/rooms/$(roomId);
    }

    function isParticipant(roomId) {
      return signedIn()
        && exists(roomRef(roomId))
        && (
          get(roomRef(roomId)).data.hostId == request.auth.uid
          || get(roomRef(roomId)).data.guestId == request.auth.uid
        );
    }

    match /rooms/{roomId} {
      // Oda kodunu bilen anonim kullanıcı, boş odayı görebilir ve katılma isteği yapabilir.
      allow get: if signedIn() && (
        isParticipant(roomId)
        || resource.data.guestId == null
      );
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.hostId == request.auth.uid
        && request.resource.data.guestId == null
        && request.resource.data.status == "active";

      // Sadece boş odaya, host olmayan ikinci kişi katılabilir.
      allow update: if signedIn() && (
        (
          resource.data.guestId == null
          && request.auth.uid != resource.data.hostId
          && request.resource.data.hostId == resource.data.hostId
          && request.resource.data.guestId == request.auth.uid
          && request.resource.data.status == "active"
        )
        || (
          isParticipant(roomId)
          && request.resource.data.hostId == resource.data.hostId
          && request.resource.data.guestId == resource.data.guestId
          && request.resource.data.status == "deleting"
        )
      );

      // Mesajlar temizlendikten sonra oda belgesi de silinir.
      allow delete: if isParticipant(roomId);

      match /messages/{messageId} {
        allow read: if isParticipant(roomId);

        allow create: if isParticipant(roomId)
          && get(roomRef(roomId)).data.status == "active"
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;

        allow update: if false;
        allow delete: if isParticipant(roomId);
      }
    }
  }
}
