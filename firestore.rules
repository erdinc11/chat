rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isCurrentRoom(roomId) {
      return roomId == "current";
    }

    function isParticipant(roomId) {
      return signedIn()
        && isCurrentRoom(roomId)
        && exists(/databases/$(database)/documents/rooms/$(roomId))
        && (
          get(/databases/$(database)/documents/rooms/$(roomId)).data.hostId == request.auth.uid
          || get(/databases/$(database)/documents/rooms/$(roomId)).data.guestId == request.auth.uid
        );
    }

    match /rooms/{roomId} {
      // Spark sürümünde yalnızca tek aktif oda tutulur: rooms/current.
      allow get: if signedIn()
        && isCurrentRoom(roomId)
        && (
          resource == null
          ||
          isParticipant(roomId)
          || resource.data.guestId == null
        );
      allow list: if false;

      // İlk oda, current belgesi yokken herhangi bir anonim kullanıcı tarafından açılabilir.
      allow create: if signedIn()
        && isCurrentRoom(roomId)
        && request.resource.data.hostId == request.auth.uid
        && request.resource.data.guestId == null
        && request.resource.data.hasGuest == false
        && request.resource.data.status == "active"
        && request.resource.data.roomId is string
        && request.resource.data.messages is list
        && request.resource.data.messages.size() == 0;

      allow update: if signedIn() && isCurrentRoom(roomId) && (
        // İkinci kişi boş odaya katılır.
        (
          resource.data.guestId == null
          && resource.data.hasGuest == false
          && request.auth.uid != resource.data.hostId
          && request.resource.data.hostId == resource.data.hostId
          && request.resource.data.guestId == request.auth.uid
          && request.resource.data.hasGuest == true
          && request.resource.data.roomId == resource.data.roomId
          && request.resource.data.status == "active"
          && request.resource.data.messages == resource.data.messages
        )
        ||
        // Mevcut katılımcılardan biri yeni global odayı açar ve messages alanını sıfırlar.
        (
          isParticipant(roomId)
          && request.resource.data.hostId == request.auth.uid
          && request.resource.data.guestId == null
          && request.resource.data.hasGuest == false
          && request.resource.data.status == "active"
          && request.resource.data.roomId is string
          && request.resource.data.messages is list
          && request.resource.data.messages.size() == 0
        )
        ||
        // Katılımcılar mevcut odanın messages listesini güncelleyebilir.
        (
          isParticipant(roomId)
          && request.resource.data.hostId == resource.data.hostId
          && request.resource.data.guestId == resource.data.guestId
          && request.resource.data.hasGuest == resource.data.hasGuest
          && request.resource.data.roomId == resource.data.roomId
          && request.resource.data.status == "active"
          && request.resource.data.messages is list
        )
      );

      allow delete: if isParticipant(roomId);
    }
  }
}
